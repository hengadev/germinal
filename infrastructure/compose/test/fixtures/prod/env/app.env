# Harness fixture — FAKE values only, never real secrets (issue 007).
# Stands in for the Infisical Agent's rendering of env/app.env in production
# (infrastructure/infisical/templates/app.env.tmpl): /app + /redis + the
# third-party folders, plus DATABASE_URL assembled from /db. The app image
# runs NODE_ENV=production, so the full production env schema
# (src/lib/server/env.ts) must be satisfied — with obvious fakes.
DATABASE_URL=postgresql://germinal:harness-fixture-prod-db@postgres:5432/germinal
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
PUBLIC_URL=https://germinalstudio.co
CONTACT_EMAIL=contact@harness.fixture
SMTP_FROM_EMAIL=noreply@harness.fixture
SMTP_FROM_NAME=Germinal Harness
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
RESERVATION_EXPIRY_MINUTES=15
USE_MOCK_DATA=false
USE_SCHEDULER=false
MAINTENANCE_MODE=false
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=harness-fixture-aws-key
AWS_SECRET_ACCESS_KEY=harness-fixture-aws-secret
S3_BUCKET_NAME=germinal-media-harness
S3_PUBLIC_URL=https://media.harness.fixture
STRIPE_SECRET_KEY=harness-fixture-stripe-secret
STRIPE_WEBHOOK_SECRET=harness-fixture-stripe-webhook
