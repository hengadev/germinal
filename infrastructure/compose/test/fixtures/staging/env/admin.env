# Harness fixture — FAKE values only (issue 007).
# Stands in for the Agent's staging rendering of env/admin.env (the /admin
# folder). A different email than prod's fixture so the harness can tell the
# two bootstraps apart. Loaded ONLY by the one-off `staging_admin` service.
ADMIN_EMAIL=staging-admin@harness.fixture
ADMIN_PASSWORD=harness-fixture-staging-admin-password
ADMIN_FIRST_NAME=Harness
ADMIN_LAST_NAME=Staging
