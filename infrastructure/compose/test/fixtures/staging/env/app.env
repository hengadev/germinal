# Harness fixture — FAKE values only, never real secrets (issue 007).
# Stands in for the Agent's staging rendering of env/app.env. DATABASE_URL
# points at the shared `postgres` container using staging's dedicated role
# and database (created by the harness the way PRD M4's Ansible setup will);
# Redis is staging's own (staging_redis, issue 029), with its own password.
DATABASE_URL=postgresql://germinal_staging:harness-fixture-staging-db@postgres:5432/germinal_staging
REDIS_HOST=staging_redis
REDIS_PORT=6379
REDIS_PASSWORD=harness-fixture-staging-redis
REDIS_DB=0
# The client IP comes from Caddy's X-Real-IP {client_ip} (issue 012)
ADDRESS_HEADER=x-real-ip
PUBLIC_URL=https://staging.germinalstudio.co
CONTACT_EMAIL=contact-staging@harness.fixture
SMTP_FROM_EMAIL=noreply-staging@harness.fixture
SMTP_FROM_NAME=Germinal Harness Staging
BREVO_API_KEY=harness-fixture-staging-brevo-key
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
RESERVATION_EXPIRY_MINUTES=15
USE_MOCK_DATA=false
USE_SCHEDULER=false
MAINTENANCE_MODE=false
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=harness-fixture-staging-aws-key
AWS_SECRET_ACCESS_KEY=harness-fixture-staging-aws-secret
S3_BUCKET_NAME=germinal-media-harness-staging
S3_PUBLIC_URL=https://media-staging.harness.fixture
STRIPE_SECRET_KEY=harness-fixture-stripe-secret
STRIPE_WEBHOOK_SECRET=harness-fixture-stripe-webhook
