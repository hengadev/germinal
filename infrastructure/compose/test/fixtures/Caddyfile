# Harness-only Caddyfile (issue 007 fixture).
#
# The real Caddyfile is rendered by the Ansible caddy role (Cloudflare DNS-01,
# real domains). This fixture keeps the one thing the harness checks: the
# upstream container names must match the compose files' container_name
# values (germinal_app / germinal_staging_app) — and the client-IP settings
# (issue 012). Plain HTTP with explicit
# http:// site addresses (with auto_https off a bare hostname would still
# bind :443, not :80) and host matching — no ACME, so the fake caddy.env
# token stays unused.
{
	admin off
	# As in production (issue 012), with the harness network's trusted range
	# standing in for Cloudflare's edges (run-harness.sh TRUSTED_PEER_IP).
	servers {
		trusted_proxies static 10.213.77.192/26
		client_ip_headers CF-Connecting-IP
	}
}

http://harness.germinal.test {
	reverse_proxy germinal_app:3001 {
		header_up X-Real-IP {client_ip}
		header_up -X-Forwarded-For
	}
}

http://harness-staging.germinal.test {
	reverse_proxy germinal_staging_app:3001 {
		header_up X-Real-IP {client_ip}
		header_up -X-Forwarded-For
	}
}
