#!/usr/bin/env bash
# Managed by Ansible (roles/backup) — DO NOT EDIT MANUALLY
#
# germinal-snapshot — the weekly recovery snapshot of Infisical
# `{{ backup_snapshot_environment }}` (issue 013), run as root by germinal-snapshot.timer.
#
# One recursive API call with the Infisical Agent's own access token (the
# server needs no second Infisical credential), kept with each key's folder
# so the folders can be re-created. The plaintext only ever exists in a pipe:
# it is encrypted with the operator's age PUBLIC key before touching disk,
# and the server has no key that can decrypt it (the private key lives only
# in the operator's password manager).
#
# Upload: weekly/infisical/germinal_{{ backup_snapshot_environment }}_secrets_<timestamp>.json.age,
# expired with the weekly tier. Decrypt and recover: roles/backup/README.md.

# shellcheck source=/dev/null
. {{ backup_lib_file }}
backup_init

recipient={{ backup_age_recipient | quote }}
token_file={{ backup_infisical_token_file }}
url="{{ backup_infisical_host }}/api/v3/secrets/raw?workspaceId={{ infisical_project_id }}&environment={{ backup_snapshot_environment }}&secretPath=/&recursive=true&include_imports=false&expandSecretReferences=false"

[ -s "$token_file" ] || die "$token_file is empty (is infisical-agent running?)"

work=$(mktemp -d "$backup_work_dir/snapshot.XXXXXX")
trap 'rm -rf "$work"' EXIT
out=$work/germinal_{{ backup_snapshot_environment }}_secrets_$timestamp.json.age

# The token reaches curl through a file descriptor, not its command line.
# jq refuses an empty answer and values the identity may not read, and
# writes only folder names and counts (or its error, which never contains a
# value) to stderr, for the journal. The ciphertext is uploaded only if
# every step of the pipe succeeded.
log "exporting {{ backup_snapshot_environment }}"
if ! curl -fsS --max-time 60 -H @<(printf 'Authorization: Bearer %s\n' "$(<"$token_file")") "$url" |
	jq -ce --arg env {{ backup_snapshot_environment }} --arg at "$timestamp" '
		if (.secrets | length) == 0 then error("no secrets returned")
		elif any(.secrets[]; .secretValueHidden == true) then error("some values are hidden from the Agent identity")
		else
			(.secrets | group_by(.secretPath) | map("\(.[0].secretPath)=\(length)") | join(" ") | stderr | empty),
			{
				format: "germinal-infisical-snapshot/1",
				project: "{{ infisical_project_id }}",
				environment: $env,
				takenAt: $at,
				secrets: [.secrets[] | {path: .secretPath, key: .secretKey, value: .secretValue, comment: (.secretComment // "")}]
					| sort_by(.path, .key)
			}
		end' 2>"$work/jq.log" |
	age -r "$recipient" -o "$out"; then
	cat "$work/jq.log" >&2
	die "export or encryption failed; nothing uploaded"
fi
log "folders (keys): $(tr -d '"' <"$work/jq.log")"

upload "$out" "weekly/infisical/$(basename "$out")"
log "OK: snapshot done"
