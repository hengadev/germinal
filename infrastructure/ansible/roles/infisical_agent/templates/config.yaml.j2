# {{ ansible_managed }}
# Infisical Agent configuration — rendered by the Ansible infisical_agent
# role (issue 008). Do not edit: re-run the role instead.
#
# Schema notes (verified against infisical 0.43.138, issue 005):
# - auth.config.client-id / client-secret are PATHS to files, not values:
#   the credential lives in root-only files under the credentials directory.
# - polling-interval has a 60s minimum; shorter values shut the Agent down.
# - a config error makes the Agent exit with status 0: the unit uses
#   Restart=always.
# - no inline Jinja block tags on content lines in this file: with Ansible's
#   trim_blocks they swallow the newline and corrupt the YAML.

infisical:
  address: {{ infisical_agent_host }}

auth:
  type: "universal-auth"
  config:
    client-id: {{ infisical_agent_credentials_dir }}/client-id
    client-secret: {{ infisical_agent_credentials_dir }}/client-secret
    remove_client_secret_on_read: false

sinks:
  - type: "file"
    config:
      path: {{ infisical_agent_token_sink }}

templates:
{% for t in infisical_agent_templates %}
  # {{ t.env }}/{{ t.name }} — {{ 'recreate the service when the rendered file changes (restart does not reload env_file)' if t.recreate else 'rewrite the file only, no command' }}{{ ' — POSTGRES_PASSWORD applies at first init only; rotation is manual (ADR 0004)' if t.name == 'postgres' else '' }}
  - source-path: {{ infisical_agent_templates_dir }}/{{ t.env }}-{{ t.name }}.env.tmpl
    destination-path: {{ infisical_agent_stack_roots[t.env] }}/{{ infisical_agent_env_dir_name }}/{{ t.name }}.env
    config:
      polling-interval: {{ infisical_agent_polling_interval }}
{% if t.recreate %}
      execute:
        # t.service (not t.name): staging's services carry a staging_ prefix
        # to avoid the `app` DNS-alias collision on the shared network —
        # see defaults/main.yml and infrastructure/compose/.
        command: docker compose --project-directory {{ infisical_agent_stack_roots[t.env] }} up -d --no-deps {{ t.service }}
        timeout: {{ infisical_agent_command_timeout_seconds }}
{% endif %}
{% endfor %}
