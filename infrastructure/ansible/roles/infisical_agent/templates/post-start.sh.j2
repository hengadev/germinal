#!/bin/sh
# {{ ansible_managed }}
# infisical_agent post-start helper (issue 008).
#
# Why this exists: the Infisical Agent never runs a template's execute
# command on the FIRST render after a start (issue 005). So a value that
# changed while the Agent was down (or before a rotation restart) would be
# written to the env file but never applied to the running container.
#
# How it works:
#   snapshot (ExecStartPre)  - checksum the rendered env files BEFORE the
#                              Agent starts, and stamp the time.
#   apply     (ExecStartPost) - wait for the first render (every destination
#                              file rewritten since the snapshot), then
#                              recreate the compose services once — only if
#                              the rendered content actually changed.
#
# `docker compose up -d` is a no-op for containers whose configuration did
# not change, so an unchanged re-render (e.g. a credential rotation restart)
# touches no container. The script always exits 0: a failure here must never
# take the Agent service down.
set -u

SNAPSHOT_FILE=/run/{{ infisical_agent_unit_name }}/pre-start.sum
WAIT_LIMIT={{ infisical_agent_post_start_wait_seconds }}
CMD_TIMEOUT={{ infisical_agent_command_timeout_seconds }}

DESTINATIONS="
{% for t in infisical_agent_templates %}
{{ infisical_agent_stack_roots[t.env] }}/{{ infisical_agent_env_dir_name }}/{{ t.name }}.env
{% endfor %}"

log() {
	echo "{{ infisical_agent_unit_name }} post-start: $*" >&2
}

snapshot() {
	for f in $DESTINATIONS; do
		if [ -f "$f" ]; then
			sha256sum "$f" | cut -d' ' -f1
		else
			echo MISSING
		fi
	done
}

# Has the Agent's first render happened? It rewrites every destination file
# on the first render (verified against 0.43.138: the write is unconditional
# when the ETag is unknown), so "every file exists and was modified at or
# after the snapshot stamp" is the readiness signal.
first_render_done() {
	for f in $DESTINATIONS; do
		[ -f "$f" ] || return 1
		[ "$(stat -c %Y "$f" 2>/dev/null || echo 0)" -ge "$1" ] || return 1
	done
	return 0
}

case "${1:-}" in
snapshot)
	umask 0077
	mkdir -p "$(dirname "$SNAPSHOT_FILE")"
	{
		date +%s
		snapshot
	} >"$SNAPSHOT_FILE"
	;;

apply)
	if [ ! -f "$SNAPSHOT_FILE" ]; then
		log "no pre-start snapshot; assuming changed (recreate commands are no-ops when nothing changed)"
		before="missing"
	else
		stamp=$(sed -n '1p' "$SNAPSHOT_FILE")
		before=$(sed -n '2,$p' "$SNAPSHOT_FILE")
	fi

	waited=0
	if [ "${before:-missing}" != "missing" ]; then
		until first_render_done "$stamp" || [ "$waited" -ge "$WAIT_LIMIT" ]; do
			sleep 2
			waited=$((waited + 2))
		done
		if [ "$waited" -ge "$WAIT_LIMIT" ] && ! first_render_done "$stamp"; then
			log "first render not observed within ${WAIT_LIMIT}s (Infisical unreachable?); checking content anyway"
		fi
	fi

	after=$(snapshot)

	if [ "$before" = "$after" ]; then
		log "rendered files unchanged; nothing to recreate"
		exit 0
	fi

	log "rendered files changed; recreating consumers"
{% for t in infisical_agent_templates if t.recreate %}
	root={{ infisical_agent_stack_roots[t.env] }}
	if [ ! -f "$root/{{ infisical_agent_compose_file }}" ]; then
		log "$root/{{ infisical_agent_compose_file }} not present yet; skipping {{ t.env }}/{{ t.name }} (the first deploy installs it)"
	else
		log "recreating {{ t.service }} ($root)"
		timeout "$CMD_TIMEOUT" docker compose --project-directory "$root" up -d --no-deps {{ t.service }} \
			|| log "recreating {{ t.service }} failed (the next change or deploy retries)"
	fi
{% endfor %}
	exit 0
	;;

*)
	log "usage: $0 {snapshot|apply}"
	exit 0
	;;
esac

exit 0
