{{- /*
	app.env - every value the app container receives, one file per environment.

	Rules (see README.md next to this file):
	- ONE recursive listSecrets call over the whole environment, filtered by
	  folder (.SecretPath). Issue 005: every secret call overwrites the ETag
	  the Agent monitors, so with one call per folder only the last folder
	  would be change-detected. One recursive call makes a change in any app
	  folder reach the running app within one poll.
	- Folders the app must not receive (/admin, /caddy, /backup, /host) are
	  filtered out here. A change in one of them still changes the ETag, so
	  it may trigger a recreate of the app with identical values: harmless.
	- /db contributes only DATABASE_URL. The raw POSTGRES_* keys never reach
	  the app container.
*/ -}}
# germinal app.env - rendered from Infisical environment __GERMINAL_ENV__
# by the Infisical Agent (server) or `make env` (local). Do not edit.
{{- $pgUser := "" -}}
{{- $pgPassword := "" -}}
{{- $pgHost := "" -}}
{{- $pgPort := "" -}}
{{- $pgDb := "" -}}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/" `{"recursive": true}` -}}
{{- if or (eq .SecretPath "/app") (eq .SecretPath "/redis") (eq .SecretPath "/stripe") (eq .SecretPath "/s3") (eq .SecretPath "/smtp") (eq .SecretPath "/twilio") (eq .SecretPath "/sentry") }}
{{ .Key }}={{ .Value }}
{{- else if eq .SecretPath "/db" -}}
{{- if eq .Key "POSTGRES_USER" }}{{ $pgUser = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_PASSWORD" }}{{ $pgPassword = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_HOST" }}{{ $pgHost = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_PORT" }}{{ $pgPort = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_DB" }}{{ $pgDb = .Value }}{{ end -}}
{{- end -}}
{{- end }}
{{- /* /db atoms -> DATABASE_URL, urlencoded with Go's urlquery. Keep the
     POSTGRES_PASSWORD letters-and-digits only: urlquery encodes a space as
     `+`, which is wrong inside userinfo (issue 005). */}}
DATABASE_URL=postgresql://{{ urlquery $pgUser }}:{{ urlquery $pgPassword }}@{{ $pgHost }}:{{ $pgPort }}/{{ $pgDb }}
