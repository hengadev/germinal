{{- /*
	app.env - every value the app container receives, one file per environment.

	Rules (see README.md next to this file):
	- One listSecrets call per folder, and a folder's atoms are picked out of
	  that single range. Issue 005: every secret call overwrites the ETag the
	  Agent monitors, so reading a folder through two calls breaks change
	  detection for it.
	- /app is deliberately the LAST call. Only the last call's folder is
	  change-detected, and /app holds the values that must reach a running
	  app within one poll (MAINTENANCE_MODE, RESERVATION_EXPIRY_MINUTES,
	  upload limits). Rotations in the other folders land on the next
	  deploy, which recreates the app with a fresh env_file.
	- /db contributes only DATABASE_URL. The raw POSTGRES_* keys never reach
	  the app container.
*/ -}}
# germinal app.env - rendered from Infisical environment __GERMINAL_ENV__
# by the Infisical Agent (server) or `make env` (local). Do not edit.
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/redis" }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/stripe" }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/s3" }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/smtp" }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/twilio" }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/sentry" }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- /* /db atoms -> DATABASE_URL, urlencoded with Go's urlquery. Keep the
     POSTGRES_PASSWORD letters-and-digits only: urlquery encodes a space as
     `+`, which is wrong inside userinfo (issue 005). */ -}}
{{- $pgUser := "" -}}
{{- $pgPassword := "" -}}
{{- $pgHost := "" -}}
{{- $pgPort := "" -}}
{{- $pgDb := "" -}}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/db" -}}
{{- if eq .Key "POSTGRES_USER" }}{{ $pgUser = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_PASSWORD" }}{{ $pgPassword = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_HOST" }}{{ $pgHost = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_PORT" }}{{ $pgPort = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_DB" }}{{ $pgDb = .Value }}{{ end -}}
{{- end }}
DATABASE_URL=postgresql://{{ urlquery $pgUser }}:{{ urlquery $pgPassword }}@{{ $pgHost }}:{{ $pgPort }}/{{ $pgDb }}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/app" }}
{{ .Key }}={{ .Value }}
{{- end }}
