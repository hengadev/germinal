{{- /*
	redis.env - the Redis container's password only (issue 029): the /redis
	folder's REDIS_PASSWORD, read by the container's own command
	(--requirepass) and healthcheck. Nothing else from /redis reaches Redis.
	Single folder, single listSecrets call; the Agent recreates the Redis
	service when it changes. The app gets the same key through app.env,
	which prints the whole /redis folder.
*/ -}}
# germinal redis.env - rendered from Infisical environment __GERMINAL_ENV__
# by the Infisical Agent. Do not edit.
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/redis" }}
{{- if eq .Key "REDIS_PASSWORD" }}
REDIS_PASSWORD={{ .Value }}
{{- end }}
{{- end }}
