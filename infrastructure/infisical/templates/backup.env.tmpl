{{- /*
	backup.env - credentials for the backup job: every key in /backup plus
	the two /db atoms pg_dump needs (user and database name; the dump runs
	through `docker exec`, so no host or port).

	ONE recursive listSecrets call, filtered by folder (.SecretPath), so a
	change in /backup or /db is change-detected (issue 005: only the last
	secret call's ETag counts). The Agent rewrites this file with no
	command; the backup job reads it fresh on each run.
*/ -}}
# germinal backup.env - rendered from Infisical environment __GERMINAL_ENV__
# by the Infisical Agent. Do not edit.
{{- $pgUser := "" -}}
{{- $pgDb := "" -}}
{{- range listSecrets "78c404c2-a76c-4967-8ff0-e7544f1b6fff" "__GERMINAL_ENV__" "/" `{"recursive": true}` -}}
{{- if eq .SecretPath "/backup" }}
{{ .Key }}={{ .Value }}
{{- else if eq .SecretPath "/db" -}}
{{- if eq .Key "POSTGRES_USER" }}{{ $pgUser = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_DB" }}{{ $pgDb = .Value }}{{ end -}}
{{- end -}}
{{- end }}
POSTGRES_USER={{ $pgUser }}
POSTGRES_DB={{ $pgDb }}
