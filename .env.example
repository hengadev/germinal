# ==============================================================
# Germinal - "try it" configuration
# ==============================================================
# Copy this file and start the app with seeded demo content:
#
#     cp .env.example .env && make try
#
# That is all a portfolio visitor needs: Docker, Node.js 20+ and pnpm
# aside, no account of any kind (no Stripe, AWS, Twilio, Infisical...)
# is required. See README -> "Try it locally".
#
# Every integration below is intentionally commented out. Leaving a
# value empty (or absent) DISABLES that integration - the app degrades
# gracefully instead of calling a service with placeholder credentials.
#
# Invited contributors: `make env` (after `infisical login`) renders a
# complete .env from the team's Infisical dev environment.

# --- Local database (the `db` service from docker-compose.yml) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/germinal

# --- Local Redis (the `redis` service from docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Demo admin account, created by `make try` ---
ADMIN_EMAIL=admin@germinal.local
ADMIN_PASSWORD=germinal-demo-admin
ADMIN_FIRST_NAME=Demo
ADMIN_LAST_NAME=Admin

# ==============================================================
# Integrations (optional - leaving a value empty disables it)
# ==============================================================

# Stripe payments (checkout + webhooks) - test-mode keys from
# https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AWS - S3 media uploads and SES email sending
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_PUBLIC_URL=

# Email sender identity (used by SES; From address and contact inbox)
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=
# CONTACT_EMAIL=

# Twilio SMS notifications
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_PHONE_NUMBER=

# Sentry error monitoring
# SENTRY_DSN=

# Force maintenance mode on for the whole public site, before any database
# read. Any other value leaves the admin settings toggle in charge.
# MAINTENANCE_MODE=false

# Background scheduler (reservation cleanup, reminders, email queue)
# USE_SCHEDULER=false
